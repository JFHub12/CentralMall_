# OPENROUTER_API_KEY: Required for OpenRouter AI API chatbox integration.
# Insert your OpenRouter API key here (e.g. sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxx).
# Kept securely on the server side and never exposed to the client.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# OPENROUTER_MODEL: AI model to query via OpenRouter.
# Recommended examples: "openai/gpt-4o-mini", "meta-llama/llama-3.3-70b-instruct", "deepseek/deepseek-chat", "google/gemini-2.5-flash"
OPENROUTER_MODEL="openai/gpt-4o-mini"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
